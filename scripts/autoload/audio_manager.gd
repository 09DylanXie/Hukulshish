extends Node
## Plays sound effects (autoload "AudioManager"). Files are generated by tools/generate_sfx.py;
## replacing a .wav in assets/audio/sfx/ with another of the same name is all a new sound needs.
## Missing files are skipped, so the game still runs while sounds are being swapped out.

const SFX_DIR: String = "res://assets/audio/sfx/"
## How many one-shot sounds can overlap. Extra requests are dropped.
const POOL_SIZE: int = 24
## play_at() is at full volume inside the first radius and silent beyond the second.
const HEARING_FULL_PX: float = 520.0
const HEARING_MAX_PX: float = 1150.0
const DEFAULT_GAP_SEC: float = 0.03
const SFX_BUS: StringName = &"SFX"

## db = volume trim, gap = minimum seconds between plays, pitch = random +/- fraction,
## variants = number of files named <sound>_1.wav, <sound>_2.wav, ...
const SOUNDS: Dictionary = {
	"cast_base": {"db": -9.0, "gap": 0.05, "pitch": 0.04, "variants": 3},
	"cast_boss_spell": {"db": -8.0, "gap": 0.06, "pitch": 0.03},
	"spell_hit": {"db": -9.0, "gap": 0.05, "pitch": 0.08, "variants": 3},
	"split_spell": {"db": -11.0, "gap": 0.08, "pitch": 0.05},
	"chain_lightning": {"db": -9.0, "gap": 0.1, "pitch": 0.05},
	"bomb_explosion": {"db": -7.0, "gap": 0.12, "pitch": 0.06},
	"fire_loop": {"db": -15.0},
	"sniper_shot": {"db": -7.0, "gap": 0.06, "pitch": 0.03},
	"player_hurt": {"db": -3.0},
	"shield_hit": {"db": -3.0},
	"player_death": {"db": 0.0},
	"revive": {"db": -2.0},
	"goblin_death": {"db": -7.0, "gap": 0.05, "pitch": 0.08},
	"undead_death": {"db": -6.0, "gap": 0.05, "pitch": 0.08},
	"demon_death": {"db": -7.0, "gap": 0.05, "pitch": 0.06},
	"ogre_death": {"db": -7.0, "gap": 0.05, "pitch": 0.06},
	"demon_shield_break": {"db": -7.0, "gap": 0.05, "pitch": 0.05},
	"undead_slow_cast": {"db": -10.0, "gap": 0.1, "pitch": 0.06},
	"nest_hit": {"db": -10.0, "gap": 0.1, "pitch": 0.08},
	"nest_destroyed": {"db": -2.0},
	"boss_spawn": {"db": -2.0},
	"boss_hit": {"db": -8.0, "gap": 0.12, "pitch": 0.08},
	"boss_death": {"db": -2.0},
	"boss_shot": {"db": -8.0, "gap": 0.08, "pitch": 0.05},
	"mega_boss_spawn": {"db": 0.0},
	"mega_boss_shield_regen": {"db": -2.0},
	"mega_boss_death": {"db": 0.0},
	"gold_pickup": {"db": -13.0, "gap": 0.06, "pitch": 0.04, "variants": 2},
	"gold_mine_collect": {"db": -6.0, "gap": 0.2},
	"scroll_pickup": {"db": -5.0, "gap": 0.05},
	"boss_spell_pickup": {"db": -3.0},
	"potion_use": {"db": -6.0},
	"heal": {"db": -5.0},
	"castle_enter": {"db": -5.0},
	"shop_buy": {"db": -5.0},
	"shop_deny": {"db": -8.0},
	"ui_click": {"db": -8.0},
	"victory": {"db": -1.0},
	"defeat": {"db": -1.0},
	"endless_wave": {"db": -2.0},
}

## Sound name -> Array of loaded streams, one per variant.
var _streams: Dictionary = {}
## Sound name -> Time.get_ticks_msec() of its most recent play.
var _last_played_ms: Dictionary = {}
var _pool: Array[AudioStreamPlayer] = []
var _loop_players: Dictionary = {}
var _loop_users: Dictionary = {}


func _ready() -> void:
	# Menus pause the tree, and their buttons still need to click.
	process_mode = Node.PROCESS_MODE_ALWAYS
	if AudioServer.get_bus_index(SFX_BUS) < 0:
		AudioServer.add_bus()
		AudioServer.set_bus_name(AudioServer.bus_count - 1, SFX_BUS)
		AudioServer.set_bus_send(AudioServer.bus_count - 1, &"Master")
	Config.preferences_changed.connect(_apply_volume)
	_apply_volume()
	for sound_name: String in SOUNDS:
		_streams[sound_name] = _load_variants(sound_name)
	for i in POOL_SIZE:
		var player := AudioStreamPlayer.new()
		player.bus = SFX_BUS
		add_child(player)
		_pool.append(player)


func _apply_volume() -> void:
	var bus_index: int = AudioServer.get_bus_index(SFX_BUS)
	AudioServer.set_bus_mute(bus_index, Config.sfx_volume <= 0.0)
	AudioServer.set_bus_volume_db(bus_index, linear_to_db(maxf(Config.sfx_volume, 0.0001)))


func _load_variants(sound_name: String) -> Array[AudioStream]:
	var count: int = int(SOUNDS[sound_name].get("variants", 1))
	var streams: Array[AudioStream] = []
	for i in count:
		var path: String = "%s%s.wav" % [SFX_DIR, sound_name] if count == 1 else "%s%s_%d.wav" % [SFX_DIR, sound_name, i + 1]
		if ResourceLoader.exists(path):
			streams.append(load(path) as AudioStream)
	return streams


## For sounds the player should always hear: their own actions, menus, and run events.
func play(sound_name: String) -> void:
	_play(sound_name, 0.0)


## For sounds from the world: quieter with distance from the camera, silent when far away.
func play_at(sound_name: String, world_position: Vector2) -> void:
	var gain: float = _distance_gain(world_position)
	if gain > 0.0:
		_play(sound_name, linear_to_db(gain))


## Plays the cast sound for an entry of RunState.all_spells().
func play_cast(spell: Dictionary, world_position: Vector2) -> void:
	var cost: float = float(spell.get("mana_cost", Config.BASE_SPELL_MANA_COST))
	play_at("cast_boss_spell" if cost > Config.BASE_SPELL_MANA_COST else "cast_base", world_position)


## Starts a loop shared by every caller. Each start_loop() needs a matching stop_loop().
func start_loop(sound_name: String) -> void:
	var streams: Array = _streams.get(sound_name, [])
	if streams.is_empty():
		return
	var users: int = int(_loop_users.get(sound_name, 0))
	_loop_users[sound_name] = users + 1
	if users > 0:
		return
	var player: AudioStreamPlayer = _loop_players.get(sound_name)
	if player == null:
		player = AudioStreamPlayer.new()
		player.bus = SFX_BUS
		# Unlike one-shots, loops go quiet while the game is paused.
		player.process_mode = Node.PROCESS_MODE_PAUSABLE
		player.stream = streams[0]
		player.volume_db = float(SOUNDS[sound_name].get("db", 0.0))
		add_child(player)
		_loop_players[sound_name] = player
	player.play()


func stop_loop(sound_name: String) -> void:
	var users: int = int(_loop_users.get(sound_name, 0))
	if users <= 0:
		return
	_loop_users[sound_name] = users - 1
	if users == 1:
		(_loop_players[sound_name] as AudioStreamPlayer).stop()


func _distance_gain(world_position: Vector2) -> float:
	var camera: Camera2D = get_viewport().get_camera_2d()
	if camera == null:
		return 1.0
	var distance: float = camera.get_screen_center_position().distance_to(world_position)
	return 1.0 - clampf((distance - HEARING_FULL_PX) / (HEARING_MAX_PX - HEARING_FULL_PX), 0.0, 1.0)


func _play(sound_name: String, extra_db: float) -> void:
	var streams: Array = _streams.get(sound_name, [])
	if streams.is_empty():
		return
	var settings: Dictionary = SOUNDS[sound_name]
	var now: int = Time.get_ticks_msec()
	var gap_ms: int = int(float(settings.get("gap", DEFAULT_GAP_SEC)) * 1000.0)
	if _last_played_ms.has(sound_name) and now - int(_last_played_ms[sound_name]) < gap_ms:
		return
	var player: AudioStreamPlayer = _free_player()
	if player == null:
		return
	_last_played_ms[sound_name] = now
	var pitch: float = float(settings.get("pitch", 0.0))
	player.stream = streams.pick_random()
	player.volume_db = float(settings.get("db", 0.0)) + extra_db
	player.pitch_scale = randf_range(1.0 - pitch, 1.0 + pitch)
	player.play()


func _free_player() -> AudioStreamPlayer:
	for player: AudioStreamPlayer in _pool:
		if not player.playing:
			return player
	return null
