# Normalize line endings so Windows/Mac/Linux collaborators don't create
# "every line changed" diffs. Everything text is stored as LF in the repo.
* text=auto eol=lf

# Godot text formats
*.gd       text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.godot    text eol=lf
*.import   text eol=lf
*.uid      text eol=lf
*.cfg      text eol=lf
*.gdshader text eol=lf
*.md       text eol=lf
*.json     text eol=lf

# Binary assets — never diff/merge, never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.svg  text eol=lf
*.ase  binary
*.aseprite binary
*.psd  binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.res  binary
*.scn  binary

# If assets get large (>50 MB total or single files >10 MB), switch to Git LFS:
#   git lfs install
#   git lfs track "*.png" "*.wav" "*.ogg" "*.psd" "*.aseprite"
